# Development environment variables template
# Copy this file to .env.dev and fill with actual values

# Database configuration
DB_NAME=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=your_password_here
DB_PORT=5433

# Application configuration
APP_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# Development CORS (more permissive)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:8081,http://localhost:3000

# PostgreSQL logging (for development debugging)
POSTGRES_LOG_STATEMENT=all
POSTGRES_LOG_MIN_DURATION=0

# AWS (disabled in dev)
AWS_REGION=us-east-1
AWS_SECRET_NAME=disabled-in-dev